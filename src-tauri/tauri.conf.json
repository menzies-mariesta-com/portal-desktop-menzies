{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Portal",
	"version": "0.1.0",
	"identifier": "com.mariesta.menzies.portal-desktop-menzies",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:2005",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Portal",
				"width": 960,
				"height": 720,
				"minWidth": 360,
				"minHeight": 480,
				"resizable": true,
				"fullscreen": false,
				"decorations": false,
				"center": true
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:2005 http://localhost:2005; worker-src 'self' blob:"
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"resources/openvpn/**/*": "openvpn/",
			"resources/helper/**/*": "helper/"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0NkM3ODBCNjdBNDc3QUIKUldTcmQ2Um5DM2hzaENDcksweEVlWXlhRGZsbDAySyt1UkhZdmNKRldUd2pGRVVvZ0h0eHowdnkK",
			"endpoints": [
				"https://github.com/menzies-mariesta-com/portal-desktop-menzies/releases/latest/download/latest.json"
			]
		}
	}
}
